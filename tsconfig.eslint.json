{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "vitest.shims.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/storybook/test/**/*.ts",
