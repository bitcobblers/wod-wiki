# wod.wiki environment example.
#
# Two separate consumers read environment config:
#   1. Vite (playground/storybook builds + dev server) reads VITE_* from this
#      file (envDir = repo root).
#   2. The Bun API server (apps/api) and the `wod` CLI read plain non-VITE_*
#      vars from the process environment — export them or put them in your
#      shell; docker compose passes .env through automatically. Only the
#      `wod` CLI has a .env loader and command-line flags: it applies flags
#      over the process environment over .env, loading ./.env when present
#      and falling back to this workspace-root file (`--env-file <path>`
#      names an explicit file and errors when it is missing); apps/api has
#      no flag or .env loader. `bun playground` / `bun build:app` pin
#      VITE_STORAGE=indexed-db so server-mode env vars in this file cannot
#      switch the ordinary playground away from IndexedDB.

# ── Vite (frontend builds) ──────────────────────────────────────────────────
# Storage backend selector for custom vite invocations: `api` persists through
# the HTTP ApiStorage backend, anything else keeps IndexedDB. The two shipped
# builds pin this themselves (dist → indexed-db, dist-api → api).
# VITE_STORAGE=indexed-db
# API base URL for the api storage backend. A relative '/api' is the default
# and works same-origin behind `bun server` and the vite dev proxy.
VITE_API_URL=/api

# Google Analytics (optional)
# G_TAG=your-google-analytics-id

# HTTPS / TLS for the dev server (optional — Chromecast requires it).
# Leave unset to run over plain HTTP (default). Auto-detected *.ts.net certs
# in the repo root enable it; set VITE_NO_HTTPS=1 to disable the auto-detect.

# ── Database & hosting (apps/api: `bun server`, `bun start:server`, docker
#    compose; `wod` CLI: init/parse/run/query/serve) ─────────────────────────
# Hosting bind address and port (same as --host/--port).
PORT=3000
HOST=127.0.0.1
# Storage driver: sqlite (default) | turso | postgres (same as --db-driver).
DB_DRIVER=sqlite
# SQLite file path (same as --db). The `wod` CLI defaults to ./wodwiki.db;
# apps/api defaults to repo-root ./data/wodwiki.db locally, /data/wodwiki.db
# in Docker. WOD_WIKI_DB wins over SQLITE_PATH for the CLI.
# WOD_WIKI_DB=./wodwiki.db
# SQLITE_PATH=./data/wodwiki.db
# Remote libsql:// or https:// URL for the turso/sqlite drivers (optional).
# Same as --database-url (turso) or --turso-url.
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# Auth token for the remote database (optional). TURSO_AUTH_TOKEN and
# LIBSQL_AUTH_TOKEN are equivalent. Same as --turso-auth-token.
# TURSO_AUTH_TOKEN=
# LIBSQL_AUTH_TOKEN=
# postgres:// or postgresql:// URL — required by apps/api when
# DB_DRIVER=postgres; the `wod` CLI may instead use the per-property
# POSTGRES_* variables / --postgres-* flags below.
# DATABASE_URL=postgres://user:password@localhost:5432/wodwiki
# Per-property PostgreSQL alternative to DATABASE_URL (`wod` CLI only,
# optional). Same as --postgres-host/--postgres-port/--postgres-user/
# --postgres-password/--postgres-database/--postgres-ssl.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=wodwiki
# POSTGRES_SSL=prefer
# Built SPA override. apps/api resolves it repo-root relative; the `wod`
# CLI (--dist / PLAYGROUND_DIST) resolves it relative to the current directory.
# The CLI defaults to its packaged app; apps/api defaults to apps/playground/dist-api.
# PLAYGROUND_DIST=
