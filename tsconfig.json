{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "types": [
      "bun-types",
      "vite/client"
    ],
    "paths": {
      "@/*": ["./apps/playground/src/*"],
      "@bitcobblers/wod-wiki-core": ["./packages/core/src/index.ts"],
      "@bitcobblers/wod-wiki-lang": ["./packages/lang/src/index.ts"],
      "@bitcobblers/wod-wiki-lang/react": ["./packages/lang/src/react.ts"],
      "@bitcobblers/wod-wiki-wql": ["./packages/wql/src/index.ts"],
      "@bitcobblers/wod-wiki-engine": ["./packages/engine/src/index.ts"],
      "@bitcobblers/wod-wiki-storage": ["./packages/storage/src/index.ts"],
      "@bitcobblers/wod-wiki-storage/sql": ["./packages/storage/src/sql/index.ts"],
      "@bitcobblers/wod-wiki-tools": ["./packages/tools/src/index.ts"],
      "@bitcobblers/wod-wiki-tools/server": ["./packages/tools/src/server/app.ts"],
      "@bitcobblers/wod-wiki-ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "vitest.shims.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "apps",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
