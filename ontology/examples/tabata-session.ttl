    wod:hasUnit unit:SEC .

# --- Round 7 ---------------------------------------------------------------
ex:ev-r7 a wod:SegmentEvent ;
    wod:sessionOf ex:session-tabata-2026-10-20 ;
    wod:seqInSession 7 ;
    wod:outputType "segment" ;
    wod:observesEffort ex:effort-burpees ;
    wod:hasMetric ex:obs-r7-reps , ex:obs-r7-elapsed .
ex:obs-r7-reps a wod:MetricObservation ;
    sosa:observedProperty wod:mReps ;
