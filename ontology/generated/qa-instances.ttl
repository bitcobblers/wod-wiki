    qa:hasBeat qa:Seed ;
    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-04/beat/Enter> .

<https://wod.wiki/qa/journey/FED-04/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /load, /settings/storage, /note/:noteId, /results/:sessionId" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-04/beat/Sense> .

<https://wod.wiki/qa/journey/FED-04/beat/Sense> a qa:Step ;
    rdfs:label "Sense: bundle-file-input, bundle-import-error, load-zip-intake" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-04/beat/Drive> .

<https://wod.wiki/qa/journey/FED-04/beat/Drive> a qa:Step ;
    rdfs:label "Drive: Valid `.zip` round-trip export/upload and standalone `.jsonl` upload on `/load` restore Notes and Sessions into IndexedDB and UI" ;
    qa:hasBeat qa:Drive ;
    qa:beatOrder 4 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-04/beat/Prove> .

<https://wod.wiki/qa/journey/FED-04/beat/Prove> a qa:Step ;
    rdfs:label "Prove: e2e/live-app/portable-codecs-and-backup-restore.e2e.ts" ;
    qa:hasBeat qa:Prove ;
    qa:beatOrder 5 .

<https://wod.wiki/qa/journey/FED-03> a qa:Journey ;
    rdfs:label "FED-03: Publication Visibility & Feed Export" ;
    qa:journeyId "FED-03" ;
    qa:journeyTitle "Publication Visibility & Feed Export" ;
