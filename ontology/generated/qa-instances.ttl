    rdfs:label "Seed: wod:Dashboard, wod:Metric, wod:Note, wod:Notebook, wod:Page, wod:Query" ;
    qa:hasBeat qa:Seed ;
    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-01/beat/Enter> .

<https://wod.wiki/qa/journey/ANL-01/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /journal, /settings/queries, /dashboard/:slug, /dashboards" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-01/beat/Sense> .

<https://wod.wiki/qa/journey/ANL-01/beat/Sense> a qa:Step ;
    rdfs:label "Sense: stream-query-status" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-01/beat/Drive> .

<https://wod.wiki/qa/journey/ANL-01/beat/Drive> a qa:Step ;
    rdfs:label "Drive: Per-surface Query Settings persist landing WQL defaults, Group-By favorites, validation, and reset across reloads" ;
    qa:hasBeat qa:Drive ;
    qa:beatOrder 4 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-01/beat/Prove> .

<https://wod.wiki/qa/journey/ANL-01/beat/Prove> a qa:Step ;
    rdfs:label "Prove: e2e/live-app/query-settings-and-views.e2e.ts" ;
