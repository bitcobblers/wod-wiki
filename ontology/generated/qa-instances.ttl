    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Enter> .

<https://wod.wiki/qa/journey/ANL-05/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /dashboards, /dashboard/:slug, /notes" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Sense> .

<https://wod.wiki/qa/journey/ANL-05/beat/Sense> a qa:Step ;
    rdfs:label "Sense: DOM readiness" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Drive> .

<https://wod.wiki/qa/journey/ANL-05/beat/Drive> a qa:Step ;
