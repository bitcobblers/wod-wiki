    rdfs:label "Enter: /subscribe, /notebooks, /notebook/:slug, /notebook/:slug/:item, /note/:noteId, /journal, /day/:date, /run/:runtimeId, /sessions, /results/:sessionId, /settings/sync" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/RUN-02/beat/Sense> .

