<https://wod.wiki/qa/journey/RUN-01> a qa:Journey ;
    rdfs:label "RUN-01: Wall Clock & FastClock Execution Protocols" ;
    qa:journeyId "RUN-01" ;
    qa:journeyTitle "Wall Clock & FastClock Execution Protocols" ;
    qa:slug "wall-clock-and-fastclock-protocols" ;
    qa:priority "P0-gate" ;
    qa:inDomain <https://wod.wiki/qa/domain/runtime> ;
    rdfs:comment "Workout blocks run either on the standalone `/run/:runtimeId` Wall Clock or inline on `/day/:date`, supporting pause/resume, segment advancement, deterministic `fastClock` completion across countdowns and forced-rest sets, guarded Stop Session recording partial (`completed: false`) Sessions with reload-persistent inline result widgets, active-session survival across client-side route navigation, and defensive empty/reload guards." ;
    qa:hasStep <https://wod.wiki/qa/journey/RUN-01/beat/Seed>, <https://wod.wiki/qa/journey/RUN-01/beat/Enter>, <https://wod.wiki/qa/journey/RUN-01/beat/Sense>, <https://wod.wiki/qa/journey/RUN-01/beat/Drive>, <https://wod.wiki/qa/journey/RUN-01/beat/Prove> .

