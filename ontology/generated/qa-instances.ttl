<https://wod.wiki/qa/journey/ANL-04> a qa:Journey ;
    rdfs:label "ANL-04: Entity Scope & Dashboard Promotion" ;
    qa:tier "T3" ;
    qa:seam "T3-journey" ;
    qa:journeyId "ANL-04" ;
    qa:journeyTitle "Entity Scope & Dashboard Promotion" ;
    qa:slug "entity-scope-and-dashboard-promotion" ;
    qa:priority "P1-core" ;
    qa:inDomain <https://wod.wiki/qa/domain/analytics> ;
    rdfs:comment "Session execution results expose tabular `EventRecord` rows on `/results/:sessionId` synchronized with the stream WQL bar (`?q=`) across desktop and 375×812 mobile viewports, allowing an Athlete to narrow multi-Effort segment records by Effort and promote the resulting Entity Scope query into `WidgetComposerDialog` or `/dashboards?q=`, while Property Note `Metric Shake-Out Queue` summaries (`totalWork`) surface both in live Session completion and WQL aggregates." ;
    qa:hasStep <https://wod.wiki/qa/journey/ANL-04/beat/Seed>, <https://wod.wiki/qa/journey/ANL-04/beat/Enter>, <https://wod.wiki/qa/journey/ANL-04/beat/Sense>, <https://wod.wiki/qa/journey/ANL-04/beat/Drive>, <https://wod.wiki/qa/journey/ANL-04/beat/Prove> .

<https://wod.wiki/qa/journey/ANL-04/beat/Seed> a qa:Step ;
    rdfs:label "Seed: wod:Dashboard, wod:Effort, wod:EventRecord, wod:FieldValue, wod:Metric, wod:Note, wod:Query, wod:Session" ;
    qa:hasBeat qa:Seed ;
    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-04/beat/Enter> .

<https://wod.wiki/qa/journey/ANL-04/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /results/:sessionId, /dashboards, /playground/:id, /run/:runtimeId, /notes" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-04/beat/Sense> .

<https://wod.wiki/qa/journey/ANL-04/beat/Sense> a qa:Step ;
    rdfs:label "Sense: save-stream-query, widget-composer-subset, widget-composer-wql" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-04/beat/Drive> .

<https://wod.wiki/qa/journey/ANL-04/beat/Drive> a qa:Step ;
    rdfs:label "Drive: Multi-Effort Session EventRecord table filters segments by WQL, fits 375×812 mobile, and promotes Entity Scope" ;
    qa:hasBeat qa:Drive ;
    qa:beatOrder 4 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-04/beat/Prove> .

<https://wod.wiki/qa/journey/ANL-04/beat/Prove> a qa:Step ;
    rdfs:label "Prove: e2e/live-app/entity-scope-and-dashboard-promotion.e2e.ts" ;
    qa:hasBeat qa:Prove ;
    qa:beatOrder 5 .

