<https://wod.wiki/qa/journey/ANL-06> a qa:Journey ;
    rdfs:label "ANL-06: WQL Composer Scope Map & Command Palette Parity" ;
    qa:tier "T3" ;
    qa:seam "T3-journey" ;
    qa:journeyId "ANL-06" ;
    qa:journeyTitle "WQL Composer Scope Map & Command Palette Parity" ;
    qa:slug "wql-composer-and-palette" ;
    qa:priority "P1-core" ;
    qa:inDomain <https://wod.wiki/qa/domain/analytics> ;
    rdfs:comment "The WQL Composer transforms smoothly between compact Split-Pills at rest and a single live WQL editor paired with the four-zone Scope Map (`WHAT`, `WHERE`, `WHEN`, `GROUP`), while keeping desktop header popovers, the inline Metric Explorer, the `Ctrl/Cmd+K` Command Palette (`Find` vs `WQL`), and mobile Filter Sheets in sync across light and dark themes." ;
    qa:hasStep <https://wod.wiki/qa/journey/ANL-06/beat/Seed>, <https://wod.wiki/qa/journey/ANL-06/beat/Enter>, <https://wod.wiki/qa/journey/ANL-06/beat/Sense>, <https://wod.wiki/qa/journey/ANL-06/beat/Drive>, <https://wod.wiki/qa/journey/ANL-06/beat/Prove> .

