<https://wod.wiki/qa/journey/FED-01> a qa:Journey ;
    rdfs:label "FED-01: Feed Subscription & Auto-Sync Lifecycle" ;
    qa:tier "T3" ;
    qa:seam "T3-journey" ;
    qa:journeyId "FED-01" ;
    qa:journeyTitle "Feed Subscription & Auto-Sync Lifecycle" ;
    qa:slug "feed-subscription-and-autosync" ;
    qa:priority "P0-gate" ;
    qa:inDomain <https://wod.wiki/qa/domain/feeds> ;
    rdfs:comment "External `Feed`s require explicit Athlete consent at `/subscribe?source=<url>` before registering in `localStorage` or importing `Seed` chunks. Subscribed Feeds import every published Notebook chunk, support automatic version-bump syncing vs. manual check-only updates on `/settings/sync` (reachable from `/notebooks` via L2 navigation on desktop and the mobile drawer), and purge unmodified Seed rows on `Unsubscribe` / `Delete` without harming user-authored `Note`s." ;
    qa:hasStep <https://wod.wiki/qa/journey/FED-01/beat/Seed>, <https://wod.wiki/qa/journey/FED-01/beat/Enter>, <https://wod.wiki/qa/journey/FED-01/beat/Sense>, <https://wod.wiki/qa/journey/FED-01/beat/Drive>, <https://wod.wiki/qa/journey/FED-01/beat/Prove> .

