<https://wod.wiki/qa/journey/JRN-05> a qa:Journey ;
    rdfs:label "JRN-05: Markdown & Zip Journal Intake" ;
    qa:journeyId "JRN-05" ;
    qa:journeyTitle "Markdown & Zip Journal Intake" ;
    qa:slug "markdown-and-zip-journal-intake" ;
    qa:priority "P1" ;
    qa:inDomain <https://wod.wiki/qa/domain/journal> ;
    rdfs:comment "Compressed `?zip=` URL bundles and direct portable Markdown uploads let an Athlete import dated workouts into `notebook/journal` or the Playground scratchpad without auto-starting execution. Dated journal imports resolve on `/day/:date` and `/journal` and remain durable across full browser reloads, while `/load/journal` without a `?zip=` query renders a recoverable upload fallback that fits mobile `375×812` viewports cleanly." ;
