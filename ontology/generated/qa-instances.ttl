<https://wod.wiki/qa/journey/RUN-02> a qa:Journey ;
    rdfs:label "RUN-02: Read-only Intake & Single Archival Provenance Run" ;
    qa:tier "T3" ;
    qa:seam "T3-journey" ;
    qa:journeyId "RUN-02" ;
    qa:journeyTitle "Read-only Intake & Single Archival Provenance Run" ;
    qa:slug "readonly-intake-and-provenance-run" ;
    qa:priority "P0-gate" ;
    qa:inDomain <https://wod.wiki/qa/domain/runtime> ;
    rdfs:comment "Running a workout delivered by an index-first read-only Feed must never mutate the upstream markdown or spawn a duplicate Journal Note clone per run. Instead, `ensurePinnedExternalWorkout` + `prepareJournalSessionRun` pins ONE immutable local archival copy (`retention: 'session-pinned'`) under canonical `upstreamId`, records the completed `Session` directly against `upstreamId` on today's Journal calendar `Page` (`session.pageId` + `notebook_links`) and `/results/:sessionId`, renders logged workouts on `/note/:upstreamId`, and preserves both the pinned local workout copy and its completed `Session` even after unsubscribing the Feed (`upstreamStatus: 'unsubscribed'`)." ;
    qa:hasStep <https://wod.wiki/qa/journey/RUN-02/beat/Seed>, <https://wod.wiki/qa/journey/RUN-02/beat/Enter>, <https://wod.wiki/qa/journey/RUN-02/beat/Sense>, <https://wod.wiki/qa/journey/RUN-02/beat/Drive>, <https://wod.wiki/qa/journey/RUN-02/beat/Prove> .

