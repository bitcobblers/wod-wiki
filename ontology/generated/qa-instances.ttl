<https://wod.wiki/qa/journey/NBK-02> a qa:Journey ;
    rdfs:label "NBK-02: N:M Notebook Promotion & Note Provenance" ;
    qa:journeyId "NBK-02" ;
    qa:journeyTitle "N:M Notebook Promotion & Note Provenance" ;
    qa:slug "nm-promotion-and-note-provenance" ;
    qa:priority "P0-gate" ;
    qa:inDomain <https://wod.wiki/qa/domain/notebooks> ;
    rdfs:comment "Every user-owned `Note` remains anchored in private `notebook/journal` while supporting many-to-many `NotebookLink` membership across multiple user `Notebook`s via `PublicationPill` and `NotePromotionSheet` (desktop popover and 375×812 mobile bottom sheet), alongside mobile `PropertyOverrideSheet` targeting (`notebook/custom`). Conversely, read-only Feed `Note`s expose `Clone to Journal` with live `Note Provenance` linking back to the upstream `Note`, and `Register only` peer Feeds support zero-import remote Notebook preview with single-Note cloning." ;
