<https://wod.wiki/qa/journey/ANL-01> a qa:Journey ;
    rdfs:label "ANL-01: Per-Surface Query Settings & Explorer Navigation" ;
    qa:tier "T3" ;
    qa:seam "T3-journey" ;
    qa:journeyId "ANL-01" ;
    qa:journeyTitle "Per-Surface Query Settings & Explorer Navigation" ;
    qa:slug "query-settings-and-views" ;
    qa:priority "P1" ;
    qa:inDomain <https://wod.wiki/qa/domain/analytics> ;
    rdfs:comment "Each library surface owns its landing default WQL query and Group-By favorites via the page options `Query settings` dialog, re-seeding the live WQL composer and surviving browser reloads while blocking invalid queries and preserving `/settings/queries` redirect compatibility. From any `/dashboard/:slug` view, the L2 panel navigates into the Metric Explorer (`/dashboards`) and deep-links example WQL queries via `?q=`." ;
    qa:hasStep <https://wod.wiki/qa/journey/ANL-01/beat/Seed>, <https://wod.wiki/qa/journey/ANL-01/beat/Enter>, <https://wod.wiki/qa/journey/ANL-01/beat/Sense>, <https://wod.wiki/qa/journey/ANL-01/beat/Drive>, <https://wod.wiki/qa/journey/ANL-01/beat/Prove> .

