    rdfs:comment "Workout blocks run either on the standalone `/run/:runtimeId` Wall Clock or inline on `/day/:date`, supporting pause/resume, segment advancement, deterministic `fastClock` completion across countdowns and forced-rest sets, guarded Stop Session recording partial (`completed: false`) Sessions with reload-persistent inline result widgets, active-session survival across client-side route navigation, and defensive empty/reload guards." ;
    qa:hasStep <https://wod.wiki/qa/journey/RUN-01/beat/Seed>, <https://wod.wiki/qa/journey/RUN-01/beat/Enter>, <https://wod.wiki/qa/journey/RUN-01/beat/Sense>, <https://wod.wiki/qa/journey/RUN-01/beat/Drive>, <https://wod.wiki/qa/journey/RUN-01/beat/Prove> .

<https://wod.wiki/qa/journey/RUN-01/beat/Seed> a qa:Step ;
    rdfs:label "Seed: wod:Dashboard, wod:Note, wod:Notebook, wod:Page, wod:Session" ;
    qa:hasBeat qa:Seed ;
    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/RUN-01/beat/Enter> .

<https://wod.wiki/qa/journey/RUN-01/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /playground/:noteId, /run/:runtimeId, /day/:date, /note/:noteId, /results/:sessionId, /notebook/:slug/:item" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/RUN-01/beat/Sense> .

<https://wod.wiki/qa/journey/RUN-01/beat/Sense> a qa:Step ;
    rdfs:label "Sense: halted-run-notice" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/RUN-01/beat/Drive> .

<https://wod.wiki/qa/journey/RUN-01/beat/Drive> a qa:Step ;
    rdfs:label "Drive: Wall Clock pause/resume, Next Block segment advance, and guarded Stop Session partial persistence" ;
