<https://wod.wiki/qa/journey/JRN-01> a qa:Journey ;
    rdfs:label "JRN-01: Cold Boot & Home Tour" ;
    qa:tier "T3" ;
    qa:seam "T3-journey" ;
    qa:journeyId "JRN-01" ;
    qa:journeyTitle "Cold Boot & Home Tour" ;
    qa:slug "cold-boot-and-home-tour" ;
    qa:priority "P0-gate" ;
    qa:inDomain <https://wod.wiki/qa/domain/journal> ;
    rdfs:comment "The Playground landing surface (`/`) must render its hero, pitch video, and live Whiteboard Script editor before background Seed sync completes, keep the pitch stable across passive scroll until explicitly watched, allow a Visitor to launch and stop the interactive Home Tour workout with accessible 44×44px controls across desktop and 375×812 mobile viewports, reveal post-run Session Insights with a glide back to the editor, navigate into Wod Wiki University guides and `/legacy` without onboarding bleed, and pass WCAG A/AA rules." ;
    qa:hasStep <https://wod.wiki/qa/journey/JRN-01/beat/Seed>, <https://wod.wiki/qa/journey/JRN-01/beat/Enter>, <https://wod.wiki/qa/journey/JRN-01/beat/Sense>, <https://wod.wiki/qa/journey/JRN-01/beat/Drive>, <https://wod.wiki/qa/journey/JRN-01/beat/Prove> .

