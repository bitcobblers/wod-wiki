    rdfs:label "Seed: wod:Dashboard, wod:Note, wod:Query" ;
    qa:hasBeat qa:Seed ;
    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Enter> .

<https://wod.wiki/qa/journey/ANL-05/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /dashboards, /dashboard/:slug, /notes" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Sense> .

<https://wod.wiki/qa/journey/ANL-05/beat/Sense> a qa:Step ;
    rdfs:label "Sense: DOM readiness" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Drive> .

<https://wod.wiki/qa/journey/ANL-05/beat/Drive> a qa:Step ;
    rdfs:label "Drive: Sample data populates Recovery & Readiness, aligns volume units, and rounds table cells" ;
    qa:hasBeat qa:Drive ;
    qa:beatOrder 4 ;
    qa:nextStep <https://wod.wiki/qa/journey/ANL-05/beat/Prove> .

<https://wod.wiki/qa/journey/ANL-05/beat/Prove> a qa:Step ;
    rdfs:label "Prove: e2e/live-app/recovery-sample-and-dashboard-lifecycle.e2e.ts" ;
    qa:hasBeat qa:Prove ;
    qa:beatOrder 5 .

<https://wod.wiki/qa/journey/FED-01> a qa:Journey ;
    rdfs:label "FED-01: Feed Subscription & Auto-Sync Lifecycle" ;
    qa:journeyId "FED-01" ;
    qa:journeyTitle "Feed Subscription & Auto-Sync Lifecycle" ;
    qa:slug "feed-subscription-and-autosync" ;
    qa:priority "P0-gate" ;
    qa:inDomain <https://wod.wiki/qa/domain/feeds> ;
    rdfs:comment "External `Feed`s require explicit Athlete consent at `/subscribe?source=<url>` before registering in `localStorage` or importing `Seed` chunks. Subscribed Feeds import every published Notebook chunk, support automatic version-bump syncing vs. manual check-only updates on `/settings/sync` (reachable from `/notebooks` via L2 navigation on desktop and the mobile drawer), and purge unmodified Seed rows on `Unsubscribe` / `Delete` without harming user-authored `Note`s." ;
    qa:hasStep <https://wod.wiki/qa/journey/FED-01/beat/Seed>, <https://wod.wiki/qa/journey/FED-01/beat/Enter>, <https://wod.wiki/qa/journey/FED-01/beat/Sense>, <https://wod.wiki/qa/journey/FED-01/beat/Drive>, <https://wod.wiki/qa/journey/FED-01/beat/Prove> .

<https://wod.wiki/qa/journey/FED-01/beat/Seed> a qa:Step ;
    rdfs:label "Seed: wod:Attachment, wod:Feed, wod:Note, wod:Notebook, wod:Page" ;
    qa:hasBeat qa:Seed ;
    qa:beatOrder 1 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-01/beat/Enter> .

<https://wod.wiki/qa/journey/FED-01/beat/Enter> a qa:Step ;
    rdfs:label "Enter: /subscribe, /feeds, /feed/:slug, /load, /load/journal, /notebooks, /settings/sync, /page/:slug" ;
    qa:hasBeat qa:Enter ;
    qa:beatOrder 2 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-01/beat/Sense> .

<https://wod.wiki/qa/journey/FED-01/beat/Sense> a qa:Step ;
    rdfs:label "Sense: feed-intake-once, feed-intake-subscribe" ;
    qa:hasBeat qa:Sense ;
    qa:beatOrder 3 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-01/beat/Drive> .

<https://wod.wiki/qa/journey/FED-01/beat/Drive> a qa:Step ;
    rdfs:label "Drive: Subscription intake requires consent, reaches /settings/sync via L2 navigation, and remembers auto-sync across desktop and 375×812 mobile" ;
    qa:hasBeat qa:Drive ;
    qa:beatOrder 4 ;
    qa:nextStep <https://wod.wiki/qa/journey/FED-01/beat/Prove> .

<https://wod.wiki/qa/journey/FED-01/beat/Prove> a qa:Step ;
    rdfs:label "Prove: e2e/live-app/feed-subscription-and-autosync.e2e.ts" ;
    qa:hasBeat qa:Prove ;
    qa:beatOrder 5 .

<https://wod.wiki/qa/journey/FED-04> a qa:Journey ;
    rdfs:label "FED-04: Portable Codecs & Backup Restore" ;
    qa:journeyId "FED-04" ;
    qa:journeyTitle "Portable Codecs & Backup Restore" ;
    qa:slug "portable-codecs-and-backup-restore" ;
    qa:priority "P1" ;
    qa:inDomain <https://wod.wiki/qa/domain/feeds> ;
    rdfs:comment "The `/load` Portable Bundle Import surface restores canonical `.zip` archives (paired `.md` Notes + `.jsonl` Session and EventRecord telemetry) and standalone `.jsonl` bundles into IndexedDB without auto-executing workouts, while rejecting malformed or corrupt `.zip` uploads with an inline alert and zero uncaught page errors." ;
    qa:hasStep <https://wod.wiki/qa/journey/FED-04/beat/Seed>, <https://wod.wiki/qa/journey/FED-04/beat/Enter>, <https://wod.wiki/qa/journey/FED-04/beat/Sense>, <https://wod.wiki/qa/journey/FED-04/beat/Drive>, <https://wod.wiki/qa/journey/FED-04/beat/Prove> .

