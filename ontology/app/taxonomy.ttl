# wod.wiki ontology — app/taxonomy
# Library: apps/playground
# Types:   apps/playground/src/types/storage.ts (+ core mirror for TagType)
# Docs:    docs/domain-model/Tag.md, TagType.md, NoteTag.md
# ---------------------------------------------------------------------------
# Classification. Tags classify notes for discovery — nothing more. A tag
# does not create ownership, placement, a parsed projection, or write access:
# tagging a note 'effort' does not make it an Effort. Tag TYPES are dynamic,
# user-managed dimensions (v23) that also sync with note frontmatter.
# ---------------------------------------------------------------------------

@prefix wod:  <https://wod.wiki/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://wod.wiki/ontology/app/taxonomy> a owl:Ontology ;
    rdfs:label "wod.wiki ontology — app: tags & tag types" ;
    owl:versionInfo "0.2.0" .

wod:Tag a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Tag" ;
    rdfs:comment "A normalized classification concept attached to notes through NoteTag. Label is unique. Modeled as a SKOS Concept: it is vocabulary for discovery, and carries no ownership semantics. Repo store: tags. (The denormalized Note.tags string array is a projection of NoteTag rows, not the canonical persistence.)" .

wod:TagType a owl:Class ;
    rdfs:label "Tag Type" ;
    rdfs:comment "A dynamic classification DIMENSION for tags (category, type, equipment, discipline...), defined at runtime and managed in Settings. Frontmatter properties matching a registered tag type name participate in typeahead, on-the-fly tag creation, and bidirectional sync with Tag/NoteTag. Repo store: tag_types." .

wod:NoteTag a owl:Class ;
    rdfs:label "Note Tag (classification)" ;
    rdfs:comment "The normalized many-to-many junction between Note and Tag (store: note_tags). It records classification only — not query membership, source authority, or a supertype relationship — and it targets the concrete owning note id." .

wod:tagLabel a owl:DatatypeProperty ;
    rdfs:label "tag label" ;
    rdfs:domain wod:Tag ;
    rdfs:range xsd:string ;
    rdfs:comment "Repo field: Tag.label — unique display label." .

wod:hasTagType a owl:ObjectProperty ;
    rdfs:label "has tag type" ;
    rdfs:domain wod:Tag ;
    rdfs:range wod:TagType ;
    rdfs:comment "Repo field: Tag.type — in storage a STRING matching a TagType name (e.g. 'equipment'), resolved here to the TagType record. One of several string-key joins in the codebase (cf. effortSlug, blockContentId)." .

wod:tagTypeName a owl:DatatypeProperty ;
    rdfs:label "tag type name" ;
    rdfs:domain wod:TagType ;
    rdfs:range xsd:string ;
    rdfs:comment "Repo field: TagType.name — the normalized identifier slug (unique), e.g. 'equipment'. Distinct from the human label." .

wod:tagTypeLabel a owl:DatatypeProperty ;
    rdfs:label "tag type label" ;
    rdfs:domain wod:TagType ;
    rdfs:range xsd:string ;
    rdfs:comment "Repo field: TagType.label — human-readable display label, e.g. 'Equipment'." .

wod:noteTagNote a owl:ObjectProperty ;
    rdfs:label "note tag: note" ;
    rdfs:domain wod:NoteTag ;
    rdfs:range wod:Note ;
    rdfs:comment "Repo field: NoteTag.noteId." .

wod:noteTagTag a owl:ObjectProperty ;
    rdfs:label "note tag: tag" ;
    rdfs:domain wod:NoteTag ;
    rdfs:range wod:Tag ;
    rdfs:comment "Repo field: NoteTag.tagId." .

wod:hasTag a owl:ObjectProperty ;
    rdfs:label "has tag" ;
    rdfs:domain wod:Note ;
    rdfs:range wod:Tag ;
    rdfs:comment "Convenience projection of NoteTag for reading: a note has a tag when a NoteTag row joins them." .
