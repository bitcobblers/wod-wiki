# wod.wiki ontology — app/pages
# Library: apps/playground
# Types:   apps/playground/src/types/storage.ts (+ core mirror)
# Docs:    docs/domain-model/Page.md, docs/domain-model/PageNote.md
# ---------------------------------------------------------------------------
# Placement and addressing. A Page is a grouping/address record — it has no
# body, no segments, no tags of its own. Membership runs through the PageNote
# junction (DB v22), which replaced the legacy Note.pageId foreign key;
# denormalized pageId copies on child rows are deprecated legacy context.
# ---------------------------------------------------------------------------

@prefix wod:  <https://wod.wiki/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://wod.wiki/ontology/app/pages> a owl:Ontology ;
    rdfs:label "wod.wiki ontology — app: pages & placement" ;
    owl:versionInfo "0.2.0" .

wod:Page a owl:Class ;
    rdfs:label "Page" ;
    rdfs:comment "A grouping/address record for notes. Two flavors by address: a calendar page (unique date, YYYY-MM-DD, the journal-date route) or a custom page (unique slug, the named route /p/:slug). Authored content lives strictly in Notes. Repo store: page." .

wod:PageNote a owl:Class ;
    rdfs:label "Page Note (placement)" ;
    rdfs:comment "The canonical many-to-many placement junction between Page and Note (store: page_notes). Unique on (pageId, noteId): a note is placed on a page at most once, and may be placed on many pages. Replaces synthetic note merging on multi-note calendar pages." .

wod:pageDate a owl:DatatypeProperty ;
    rdfs:label "page date" ;
    rdfs:domain wod:Page ;
    rdfs:range xsd:string ;
    rdfs:comment "Repo field: Page.date — 'YYYY-MM-DD' for calendar pages; unique when present. Kept separate from any note's domain/creation date: displaying a note on a date does not rewrite its history." .

wod:pageSlug a owl:DatatypeProperty ;
    rdfs:label "page slug" ;
    rdfs:domain wod:Page ;
    rdfs:range xsd:string ;
    rdfs:comment "Repo field: Page.slug — the named route for a custom page; unique when present. Slugs route to PAGES, not notes: a slug addresses the composed page, the underlying note is addressed by id at /notes/:noteId." .

wod:pageTitle a owl:DatatypeProperty ;
    rdfs:label "page title" ;
    rdfs:domain wod:Page ;
    rdfs:range xsd:string ;
    rdfs:comment "Repo field: Page.title — display name." .

wod:placementPage a owl:ObjectProperty ;
    rdfs:label "placement page" ;
    rdfs:domain wod:PageNote ;
    rdfs:range wod:Page ;
    rdfs:comment "Repo field: PageNote.pageId." .

wod:placementNote a owl:ObjectProperty ;
    rdfs:label "placement note" ;
    rdfs:domain wod:PageNote ;
    rdfs:range wod:Note ;
    rdfs:comment "Repo field: PageNote.noteId." .

wod:placedOn a owl:ObjectProperty ;
    rdfs:label "placed on" ;
    rdfs:domain wod:Note ;
    rdfs:range wod:Page ;
    rdfs:comment "Convenience projection of PageNote for reading: a note is placed on a page when a PageNote row joins them. Ordering comes from the junction's position, not from this projection." .
