# wod.wiki ontology — SHACL shapes for app/ modules
# Contracts for apps/playground types: notes, segments, pages, taxonomy,
# attachments, library.

@prefix wod: <https://wod.wiki/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://wod.wiki/ontology/shapes/app> a owl:Ontology .

# === Note ==================================================================

wod:NoteShape a sh:NodeShape ;
    sh:targetClass wod:Note ;
    sh:property [
        sh:path wod:noteTitle ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A note has exactly one title." ;
    ] ;
    sh:property [
        sh:path wod:createdAt ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "A note has exactly one creation timestamp." ;
    ] ;
    sh:property [
        sh:path wod:noteKind ;
        sh:maxCount 1 ;
        sh:in ( "journal" "template" "playground" "collection" "dashboard" "page" "note" ) ;
        sh:message "Note kind, when present, is one of the current NoteKind values." ;
    ] ;
    sh:property [
        sh:path wod:seedOrigin ;
        sh:maxCount 1 ;
        sh:in ( "seed" "user" ) ;
        sh:message "Seed origin, when present, is 'seed' or 'user'." ;
    ] .

# === Note segment ==========================================================

wod:NoteSegmentShape a sh:NodeShape ;
    sh:targetClass wod:NoteSegment ;
    sh:property [
        sh:path wod:segmentOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Note ;
        sh:message "A segment belongs to exactly one owning note — content is never unowned." ;
    ] ;
    sh:property [
        sh:path wod:segmentVersion ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "A segment has exactly one version, >= 1 (half of its [id, version] storage key)." ;
    ] ;
    sh:property [
        sh:path wod:segmentDataType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "wod" "markdown" "frontmatter" "script" "header" "title" "youtube"
                "h1" "h2" "h3" "h4" "h5" "h6" ) ;
        sh:message "Segment data type is one of the SegmentDataType values (including admitted legacy kinds)." ;
    ] .

# === Page & placement ======================================================

wod:PageShape a sh:NodeShape ;
    sh:targetClass wod:Page ;
    sh:or (
        [ sh:property [ sh:path wod:pageDate ; sh:minCount 1 ] ]
        [ sh:property [ sh:path wod:pageSlug ; sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path wod:pageDate ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
        sh:message "A calendar page's date is 'YYYY-MM-DD'." ;
    ] ;
    sh:property [
        sh:path wod:pageSlug ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A page has at most one slug." ;
    ] .

wod:PageNoteShape a sh:NodeShape ;
    sh:targetClass wod:PageNote ;
    sh:property [
        sh:path wod:placementPage ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Page ;
        sh:message "A placement names exactly one page." ;
    ] ;
    sh:property [
        sh:path wod:placementNote ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Note ;
        sh:message "A placement names exactly one note." ;
    ] .

# === Taxonomy ==============================================================

wod:TagShape a sh:NodeShape ;
    sh:targetClass wod:Tag ;
    sh:property [
        sh:path wod:tagLabel ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A tag has exactly one (unique) label." ;
    ] ;
    sh:property [
        sh:path wod:hasTagType ;
        sh:maxCount 1 ;
        sh:class wod:TagType ;
        sh:message "A tag has at most one tag type (its classification dimension)." ;
    ] .

wod:TagTypeShape a sh:NodeShape ;
    sh:targetClass wod:TagType ;
    sh:property [
        sh:path wod:tagTypeName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ;
        sh:message "A tag type name is a normalized slug (e.g. 'equipment')." ;
    ] .

wod:NoteTagShape a sh:NodeShape ;
    sh:targetClass wod:NoteTag ;
    sh:property [
        sh:path wod:noteTagNote ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Note ;
        sh:message "A note-tag row names exactly one note." ;
    ] ;
    sh:property [
        sh:path wod:noteTagTag ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Tag ;
        sh:message "A note-tag row names exactly one tag." ;
    ] .

# === Attachment ============================================================

wod:AttachmentShape a sh:NodeShape ;
    sh:targetClass wod:Attachment ;
    sh:property [
        sh:path wod:attachedToNote ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Note ;
        sh:message "An attachment is owned by exactly one note — ownership is identified before a save claims success." ;
    ] ;
    sh:property [
        sh:path wod:attachedToSession ;
        sh:maxCount 1 ;
        sh:class wod:Session ;
        sh:message "An attachment belongs to at most one session." ;
    ] ;
    sh:property [
        sh:path wod:mimeType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An attachment has exactly one MIME type." ;
    ] .

# === Library ===============================================================

wod:BlockIndexRowShape a sh:NodeShape ;
    sh:targetClass wod:BlockIndexRow ;
    sh:property [
        sh:path wod:projectsNote ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class wod:Note ;
        sh:message "A block index row identifies its owning note (or corpus locator resolved to one)." ;
    ] .

wod:ConfigurationShape a sh:NodeShape ;
    sh:targetClass wod:Configuration ;
    sh:property [
        sh:path wod:configKey ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A configuration row has exactly one key. (Its value is opaque by design and unconstrained.)" ;
    ] .
