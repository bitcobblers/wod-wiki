# Canonical semantic triples merged from approved ontology changesets.
#
# Ownership invariant: Generated :code instances (a code:File, code:Symbol,
# code:TestId, code:Route, code:WebMcpTool, code:Story) belong EXCLUSIVELY
# to ontology/generated/code-graph.ttl and must never be duplicated here.
