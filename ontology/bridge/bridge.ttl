# wod.wiki ontology — :bridge named graph (Cross-Graph Bridge Predicates)
# Named Graph: <https://wod.wiki/graph/bridge>
# ---------------------------------------------------------------------------
# Edge-carrier vocabulary connecting Sub-Ontologies (:domain, :qa, :code)
# via sys:GraphBridge contracts and :code sys:LinkContract subproperties.
#
# Note: Legacy bridge:HermesLevel (O1-O5) has been retired in favor of
# sys:OntologyGraph + sys:ontologyKind + sys:layerOrder in ontology/system/.
# ---------------------------------------------------------------------------

@prefix bridge: <https://wod.wiki/ontology/bridge#> .
@prefix sys:    <https://wod.wiki/ontology/system#> .
@prefix wod:    <https://wod.wiki/ontology#> .
@prefix qa:     <https://wod.wiki/ontology/qa#> .
@prefix code:   <https://wod.wiki/ontology/code#> .
@prefix ufo:    <https://wod.wiki/ontology/patterns#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<https://wod.wiki/ontology/bridge> a owl:Ontology ;
    rdfs:label "wod.wiki ontology — :bridge named graph (cross-graph alignment)" ;
    owl:versionInfo "0.4.0" .

# === Bridge Object Properties ==============================================

bridge:touches a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToFile , code:linksToSymbol ;
    rdfs:label "touches" ;
    rdfs:comment "Links a qa:Journey or qa:Step to a code:Symbol or code:File exercised or depended upon by that journey/step." .

bridge:rootCause a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToFile , code:linksToSymbol ;
    sys:allowHistoricalMissingTarget true ;
    rdfs:label "root cause" ;
    rdfs:domain qa:Issue ;
    rdfs:comment "Links a qa:Issue to the code:Symbol or code:File responsible for the defect (replaces raw 'path:line' strings). Historical targets deleted after defect resolution are allowed as non-fatal drift." .

bridge:seedNoun a owl:ObjectProperty ;
    rdfs:range owl:Class ;
    rdfs:label "seed noun" ;
    rdfs:comment "Links a qa:VerificationSuite or qa:Step (typically qa:SeedBeat) to the wod: domain owl:Class it seeds or tests." .

bridge:domainMapping a owl:ObjectProperty ;
    rdfs:domain qa:Domain ;
    rdfs:label "domain mapping" ;
    rdfs:comment "Aligns a qa:Domain with its corresponding ontology module IRI (e.g. <https://wod.wiki/ontology/app/content>) or domain owl:Class." .

bridge:specFile a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToFile ;
    sys:allowHistoricalMissingTarget true ;
    rdfs:domain qa:Journey ;
    rdfs:range code:File ;
    rdfs:label "spec file" ;
    rdfs:comment "Links a qa:Journey to its Level-1 business-language Markdown spec (e2e/specs/<domain>/<journey>.md). Historical consolidated specs in qa-snapshot.ttl are allowed as non-fatal drift." .

bridge:playwrightSpec a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToFile ;
    rdfs:domain qa:Journey ;
    rdfs:range code:File ;
    rdfs:label "playwright spec" ;
    rdfs:comment "Links a qa:Journey to its Level-2 Playwright test file (e2e/live-app/<journey>.e2e.ts)." .

bridge:route a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToRoute ;
    rdfs:range code:Route ;
    rdfs:label "route" ;
    rdfs:comment "Links a qa:Journey or qa:Step to the code:Route it enters or verifies." .

bridge:testId a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToTestId ;
    rdfs:range code:TestId ;
    rdfs:label "test id" ;
    rdfs:comment "Links a qa:Journey or qa:Step to the code:TestId sensed or driven." .

bridge:webMcpTool a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToTool ;
    rdfs:range code:WebMcpTool ;
    rdfs:label "WebMCP tool" ;
    rdfs:comment "Links a qa:Journey, qa:Step, qa:VerificationSuite, or code:Route to a code:WebMcpTool invoked or exposed during agent-driven execution." .

bridge:implementsDomainClass a owl:ObjectProperty ;
    rdfs:domain code:Symbol ;
    rdfs:range owl:Class ;
    rdfs:label "implements domain class" ;
    rdfs:comment "Links a TypeScript code:Symbol (interface/class) to the wod: domain owl:Class it implements." .

bridge:story a owl:ObjectProperty ;
    rdfs:subPropertyOf code:linksToStory ;
    rdfs:range code:Story ;
    rdfs:label "story" ;
    rdfs:comment "Links a qa:Journey, qa:Step, or wod: domain owl:Class to a Storybook code:Story that exercises or renders it." .
