{
  "version": 1,
  "title": "Parser fixture catalog",
  "cases": [
    {
      "name": "Fused distances, loads, and @-bound resistance",
      "script": "400m Run\n1000m Row\n16kg KB Swing\n5 Back Squat @225lb",
      "matchMode": "closed",
      "expected": [
        {
          "line": 1,
          "metrics": [
            "Distance 400 m @parser",
            "Effort \"Run\" @parser",
            "Hint domain.cardio @dialect",
            "Hint workout.run @dialect",
            "Hint behavior.aerobic @dialect",
            "Hint behavior.distance_based @dialect",
            "Hint behavior.pace_based @dialect"
          ]
        },
        {
          "line": 2,
          "metrics": [
            "Distance 1000 m @parser",
            "Effort \"Row\" @parser",
            "Hint domain.cardio @dialect",
            "Hint workout.row @dialect",
            "Hint behavior.aerobic @dialect",
            "Hint behavior.distance_based @dialect",
            "Hint behavior.pace_based @dialect"
          ]
        },
        {
          "line": 3,
          "metrics": [
            "Resistance 16 kg @parser",
            "Effort \"KB Swing\" @parser"
          ]
        },
        {
          "line": 4,
          "metrics": [
            "Rep 5 @parser",
            "Effort \"Back Squat\" @parser",
            "Resistance 225 lb @parser"
          ]
        }
      ]
    },
    {
      "name": "Trailing comments and custom metric objects",
      "script": "10 Back Squat 225lb // last set heavy\n5 Back Squat 225lb {\"intensity\": 80, \"rpe\": 8}",
      "matchMode": "closed",
      "expected": [
        {
          "line": 1,
          "metrics": [
            "Rep 10 @parser",
            "Effort \"Back Squat\" @parser",
            "Resistance 225 lb @parser",
            "Text text:\"last set heavy\" @parser"
          ]
        },
        {
          "line": 2,
          "metrics": [
            "Rep 5 @parser",
            "Effort \"Back Squat\" @parser",
            "Resistance 225 lb @parser",
            "Intensity 80 @parser",
            "SessionRpe 8 @parser"
          ]
        }
      ]
    },
    {
      "name": "Percent intensity fused from a trailing % token",
      "script": "Run 400m 80%\nBack Squat 225lb 85%",
      "matchMode": "closed",
      "expected": [
        {
          "line": 1,
          "metrics": [
            "Effort \"Run\" @parser",
            "Distance 400 m @parser",
            "Intensity 80 % @parser",
            "Hint domain.cardio @dialect",
            "Hint workout.run @dialect",
            "Hint behavior.aerobic @dialect",
            "Hint behavior.distance_based @dialect",
            "Hint behavior.pace_based @dialect"
          ]
        },
        {
          "line": 2,
          "metrics": [
            "Effort \"Back Squat\" @parser",
            "Resistance 225 lb @parser",
            "Intensity 85 % @parser"
          ]
        }
      ]
    },
    {
      "name": "EMOM protocol with plus-composed laps",
      "script": "(10) :60 EMOM\n  + 2 Burpees\n  + 5 Push Ups\n  + 7 Air Squats",
      "matchMode": "closed",
      "expected": [
        {
          "line": 1,
          "metrics": [
            "Rounds 10 @parser",
            "Duration 1:00 @parser",
            "Effort \"EMOM\" @parser",
            "Hint behavior.repeating_interval @dialect",
            "Hint workout.emom @dialect"
          ]
        },
        {
          "line": 2,
          "metrics": [
            "Group \"compose\" @parser",
