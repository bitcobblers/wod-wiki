{
  "name": "@bitcobblers/wod-wiki-playground",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "The wod.wiki web application — workout journal, canvas editor, review surfaces, and Chromecast receiver built on the Whiteboard Language packages.",
  "scripts": {
    "dev": "bun ../../scripts/sync-seed.ts && VITE_STORAGE=indexed-db vite",
    "build": "bun ../../scripts/sync-seed.ts && VITE_STORAGE=indexed-db vite build && bun ../../scripts/generate-static-shells.ts",
    "build:api": "bun ../../scripts/sync-seed.ts && VITE_STORAGE=api VITE_API_URL=/api vite build --outDir dist-api",
    "preview": "vite preview",
    "test": "bun tests/run-isolated.ts ./src ./app --preload ./tests/unit-setup.ts",
    "test:markdown": "bun test tests/wods/all-wods.test.ts tests/canvas/syntax-source-markdown.test.ts --preload ./tests/setup.ts",
    "test:components": "bun test tests --path-ignore-patterns='tests/wods/all-wods.test.ts' --path-ignore-patterns='tests/canvas/syntax-source-markdown.test.ts' --preload ./tests/setup.ts",
    "test:all": "bun run test && bun run test:components",
    "test:coverage": "bun tests/run-isolated.ts ./src ./app --preload ./tests/unit-setup.ts",
    "test:perf": "bun test tests/performance",
    "clean": "rm -rf dist dist-api",
    "typecheck": "echo '[skip] Playground compiles via Vite/esbuild without a tsc gate; strict tsc adoption tracked as follow-up'"
  },
  "files": [
    "dist",
    "dist-api"
  ],
  "dependencies": {
    "@bitcobblers/wod-wiki-core": "^0.11.0",
    "@bitcobblers/wod-wiki-engine": "^0.11.0",
    "@bitcobblers/wod-wiki-lang": "^0.11.0",
    "@bitcobblers/wod-wiki-storage": "^0.11.0",
    "@bitcobblers/wod-wiki-ui": "^0.11.0",
    "@bitcobblers/wod-wiki-wql": "^0.11.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
