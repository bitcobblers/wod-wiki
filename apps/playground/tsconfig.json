{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["bun-types", "vite/client"],
    "paths": {
      "@/testing": ["./src/testing/index.ts"],
      "@/testing/*": ["./src/testing/*"],
      "@wod-wiki/lang-harness": ["../../packages/lang/tests/harness/index.ts"],
      "@wod-wiki/lang-harness/*": ["../../packages/lang/tests/harness/*"],
      "@bitcobblers/wod-wiki-core/testing": ["../../packages/core/src/testing.ts"],
      "@bitcobblers/wod-wiki-core": ["../../packages/core/src/index.ts"],
      "@bitcobblers/wod-wiki-lang": ["../../packages/lang/src/index.ts"],
      "@bitcobblers/wod-wiki-lang/react": ["../../packages/lang/src/react.ts"],
      "@bitcobblers/wod-wiki-wql": ["../../packages/wql/src/index.ts"],
      "@bitcobblers/wod-wiki-engine/agent": ["../../packages/engine/src/agent/index.ts"],
      "@bitcobblers/wod-wiki-engine/react": ["../../packages/engine/src/react.ts"],
      "@bitcobblers/wod-wiki-engine": ["../../packages/engine/src/index.ts"],
      "@bitcobblers/wod-wiki-storage": ["../../packages/storage/src/index.ts"],
      "@bitcobblers/wod-wiki-storage/sql": ["../../packages/storage/src/sql/index.ts"],
      "@bitcobblers/wod-wiki-storage/idb": ["../../packages/storage/src/idb/index.ts"],
      "@bitcobblers/wod-wiki-storage/sql/node": ["../../packages/storage/src/sql/node.ts"],
      "@bitcobblers/wod-wiki-tools": ["../../packages/tools/src/index.ts"],
      "@bitcobblers/wod-wiki-tools/server": ["../../packages/tools/src/server/app.ts"],
      "@bitcobblers/wod-wiki-ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
