{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "types": ["bun-types", "vite/client"],
    "paths": {
      "@/testing": ["./tests/testing/index.ts"],
      "@/testing/*": ["./tests/testing/*"],
      "@wod-wiki/lang-harness": ["../../packages/lang/tests/harness/index.ts"],
      "@wod-wiki/lang-harness/*": ["../../packages/lang/tests/harness/*"],
      "@bitcobblers/wod-wiki-core/testing": ["../../packages/core/src/testing.ts"],
      "@/*": ["./src/*"]
    },
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
