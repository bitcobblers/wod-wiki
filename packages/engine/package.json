{
  "name": "@bitcobblers/wod-wiki-engine",
  "version": "0.11.0",
  "description": "Umbrella package for Whiteboard Language & WQL engine with CLI runner",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "wod": "./dist/bin/wod.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bitcobblers/wod-wiki-core": "^0.11.0",
    "@bitcobblers/wod-wiki-lang": "^0.11.0",
    "@bitcobblers/wod-wiki-storage": "^0.11.0",
    "@bitcobblers/wod-wiki-wql": "^0.11.0",
    "@libsql/client": "^0.18.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
