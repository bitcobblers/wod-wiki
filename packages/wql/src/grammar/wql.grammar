// WQL — Wod Query Language (Datadog-flavored). See CONTEXT.md glossary.
//
//   <aggregator>:<metric.namespace>{<tag filters>} by {<dimensions>} .rollup(<period>)
//   :<source>{<filters>} | :<function>{metric:<key>, <filters>} | :<chart>{<params>}
//   @dataset | :<function>{…} | :<chart>{…}
//
//   sum:totalVolume{discipline:strength,!effort:burpee} by {week,effort}.rollup(2w)
//   avg:tis{effort:back*} by {session}
//   :journal{effort:snatch} last 8w | :sum{metric:tis} by {week} | :timeseries{}
//   @today | :count{} | :bar{type:session}
//
// Token discipline: keyword tokens with @precedence over a word token shadow
// every position GLOBALLY, not per parser state — a `rollupUnit {"d"|"w"}`
// token with precedence made `week`, `day`, `wod.volume`, `discipline`
// unparseable, and a `virtualDim` token made the metric in `count:session`
// unparseable. So this grammar lexes all words with a single `word` token and
// lets parser context disambiguate; the AST mapper
// (src/wql.ts) validates aggregators, heads, dimensions,
// and the rollup unit semantically. Structural literals (`by`, `.rollup`,
// `@`, leading `:`) keep their own tokens — they never overlap a word
// position ('@' never lexes inside Word; a leading colon starts a Head).
//
// A Query is one or more pipe-separated stages: a source (colon source head
// or @dataset reference), optionally followed by ordered function stages and
// at most one terminal chart stage. A single stage is the classic single
// query (legacy `word:metric` head or new colon head). Stage SUFFIXES
// (windows/grouping/unit/joins/pipes) are stripped in JS per stage before
// the mapper parses, and rows presentation pipes (`| select/order/limit`)
// are split in JS — the grammar's top-level pipe is the stage separator.
//
// The legacy `find:<target>` head still lexes (word:word) for the `where`
// join halves; the mapper retires it as a primary query.
@top Query { Pipeline | Single }

Single { Stage GroupBy? Rollup? }

// One pipeline stage: a colon head with filters, or a dataset reference.
// Multiple stages flow left-to-right: source, ordered functions, at most
// one terminal chart. A lone stage is Single above (classic query).
Pipeline { Stage pipe Stage (pipe Stage)* }

Stage { Head Filters? | DatasetReference }

// Colon head `:note{…}` / `:sum{…}` (Word child of Head) or the legacy
// `word:metric` head (Aggregator colon Metric — retained numerical syntax
// and the retired `find:` dispatch keyword).
Head { colon Word | Aggregator colon Metric }

// Any word — known aggregators (sum avg min max count last delta), the
// retired content keyword `find`, and unknown ones alike; the AST mapper
// reports "Unknown aggregator" for genuinely unknown ones.
Aggregator { Word }

// Dotted Canonical Metric Key namespaces: totalVolume, calc.acwr,
// <effortSlug>.<family> (segments may carry effort-slug dashes).
Metric { Word (dot Word)* }

// Standard/page dataset references: @session, @today, or a host-registered
// page source name. `@` never lexes inside Word, so At is lexically safe.
DatasetReference { At Word }

Filters { braceOpen (Filter (comma Filter)*)? braceClose }

Filter { Negate? TagKey colon TagValue }

TagKey { Word }

// Multi-value tag values: alternatives are OR-ed within the key; each
// alternative carries its own trailing wildcard star.
// A value is one or more OR-ed atoms; each atom is `Word(:Word)*` — dotted
// and catalog-id forms like `calc.acwr` / `collection:crossfit-girls` —
// or a bare `Word`, or a double-quoted phrase for multi-word text
// (`text:"300 Air Squats"`, #867). Quoted atoms carry no colon/wildcard forms.
TagValue { Value (pipe Value)* }

Value { Star | Word ((colon | dot) Word)* Star? | Quoted Star? }

GroupBy { By braceOpen (Dimension (comma Dimension)*)? braceClose }

// day | week | session | round are virtual dimensions — a lexical no-op,
// assigned meaning by the Query Service. Any other word is a fact-row tag key.
Dimension { Word }

// `.rollup` is one token: with a bare `dot` the parser would need 2-token
// lookahead to choose between a Metric continuation and the Rollup suffix.
Rollup { RollupDot parenOpen Int Word parenClose }

@tokens {
  By { "by" }
  RollupDot { ".rollup" }
  Int { $[0-9]+ }
  Word { $[a-zA-Z0-9_-]+ }
  At { "@" }
  Star { "*" }
  Negate { "!" }
  // Double-quoted phrase for multi-word text filters — lexically distinct
  // from Word (starts with `"`), so it cannot shadow any word position. The
  // AST mapper strips the quotes (src/wql.ts).
  Quoted { "\"" !["]* "\"" }
  colon { ":" }
  pipe { "|" }
  comma { "," }
  dot { "." }
  braceOpen { "{" }
  braceClose { "}" }
  parenOpen { "(" }
  parenClose { ")" }
  whitespace { (" " | "\t" | "\n" | "\r")+ }
}

@skip { whitespace }
