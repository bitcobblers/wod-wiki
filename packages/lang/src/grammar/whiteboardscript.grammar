@precedence {
  property,
  lap,
  quantity,
  effort,
  fragment,
  block
}

@top Program { (Property | Block | newline)* }

/**
 * Property — a `key: value` line.
 *
 * A value is normally a single string, number or identifier. A **tag
 * reference** (`#{tag-slug}`) is also a value, and several of them can be
 * stacked on one line so a line can point at more than one tag:
 * `sound: #{sound-classic} #{sound-loud}`.
 */
Property {
  (Identifier colon (String | Number | Identifier)) !property |
  (Identifier colon TagRef+) !property
}

Block { ((Lap !lap)? (Fragment !fragment)+ newline) !block }

Lap { minus !lap | plus !lap }

Fragment {
  Duration |
  Rounds |
  RoundScheme |
  Action |
  Text |
  Heading |
  Quantity |
  Slash |
  Pipe |
  Effort |
  MetricObject |
  TagRef
}

/**
 * RoundScheme — inline NxM rounds notation ("5x5", "3 x 8"), lexed as a single
 * token so a bare `x` inside effort words is never stolen. N rounds x M reps.
 */
RoundScheme { schemeNumber | schemeSpaced }

/**
 * Slash — a bare "/" between quantities, used for fraction notation.
 * e.g. "1/4 mile" → decimal distance 0.25 mile.
 * "1/2 pood" → decimal resistance 0.5 pood.
 * "//" is always a textComment (higher token precedence), so Slash only ever
 * captures a single forward-slash.
 */
Slash { slash }

/**
 * Pipe — a bare "|" between alternatives, used for choice notation.
 * e.g. "Run | Walk" → ChoiceGroupMetric with two effort alternatives.
 * e.g. "185 | 125 lb" → ChoiceGroupMetric with two resistance alternatives.
 */
Pipe { pipe }

MetricObject { objectOpen (Identifier | Number | String | colon | comma | True | False | Null | allowedSymbol)* objectClose }

AtSign { atSign }
Question { question }
Trend { trend }
CollectibleTimer { collectibleTimer }

Quantity {
  (AtSign)? (Question | Number) !quantity
}

Duration { (Trend | rest)? (CollectibleTimer | Timer) }

Action { actionOpen colon (Identifier | allowedSymbol | minus)+ actionClose }

Rounds { groupOpen (Identifier | Sequence)+ groupClose }

Sequence { Number (minus Number)* }

Text { textComment }

Heading { heading }

Effort { (Identifier | allowedSymbol | minus)+ !effort }

@tokens {
  Number { $[0-9]* "." $[0-9]+ | $[0-9]+ }
  schemeNumber { $[0-9]+ $[xX] $[0-9]+ }
  schemeSpaced { $[0-9]+ " "+ $[xX] " "+ $[0-9]+ }
  Timer { (":" $[0-9]+) | ($[0-9]+ ":")+ $[0-9]+ }
  collectibleTimer { ":?" }
  Identifier { $[a-zA-Z] $[a-zA-Z0-9]* }
  /**
   * TagRef — a reference to a named tag, written `#{tag-slug}`.
   *
   * Used as a property value so a line can point at a tag rather than
   * repeating what the tag means, e.g. `sound: #{sound-classic}`, and as a
   * fragment so a tag can apply to the line it sits on, e.g.
   * `5 reps @ 100 kg #{heavy}`.
   *
   * The slug allows letters, digits and hyphens. It is one token rather
   * than a composite of Identifier and minus, because a hyphen is not
   * valid inside an Identifier.
   */
  TagRef { "#{" $[a-zA-Z0-9] $[a-zA-Z0-9-]* "}" }
  String { '"' (![\\\n\r] | "\\" _) * '"' }
  textComment { "//" ![\n\r]* }
  heading { "#" ![\n\r]* }
  slash { "/" }
  pipe { "|" }
  allowedSymbol { $[\\.,@!$%^*=&]+ }
  objectOpen { "{" }
  objectClose { "}" }
  comma { "," }
  True { "true" }
  False { "false" }
  Null { "null" }
  minus { "-" }
  plus { "+" }
  trend { "^" }
  rest { "*" }
  colon { ":" }
  atSign { "@" }
  question { "?" }
  actionOpen { "[" }
  actionClose { "]" }
  groupOpen { "(" }
  groupClose { ")" }
  newline { $[ \t]* ("\n" | "\r\n") }
  whitespace { $[ \t]+ }
  @precedence {
    textComment,
    TagRef,
    heading,
    schemeNumber,
    schemeSpaced,
    collectibleTimer, 
    Timer, 
    atSign,
    trend,
    rest,
    colon,
    slash,
    pipe,
    allowedSymbol,
    objectOpen,
    objectClose,
    comma,
    True,
    False,
    Null,
    Identifier,
    minus,
    plus, 
    Number,
    newline,
    whitespace
  }
}

@skip { whitespace }
