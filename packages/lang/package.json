{
  "name": "@bitcobblers/wod-wiki-lang",
  "version": "0.11.0",
  "description": "Whiteboard Language parser, JIT compiler, runtime, and dialect execution",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bitcobblers/wod-wiki-core": "^0.11.0",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/lr": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/lr": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@lezer/common": "^1.2.3",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "happy-dom": "^20.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "generate:whiteboard": "lezer-generator --typeScript src/grammar/whiteboardscript.grammar -o src/grammar/parser",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
