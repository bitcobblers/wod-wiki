#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';

const isBun = typeof process.versions.bun !== 'undefined';
const selfDir = path.dirname(fileURLToPath(import.meta.url));
const distBin = path.resolve(selfDir, '../packages/tools/dist/bin/wod.mjs');

// 1. If precompiled bundle exists, load it (works under both Bun and Node).
if (fs.existsSync(distBin)) {
  await import(distBin);
} else if (isBun) {
  // 2. Under Bun, run TypeScript source directly without a build step.
  const { cliMain } = await import('../packages/tools/src/cli/runner');
  const exitCode = await cliMain(process.argv.slice(2));
  process.exitCode = exitCode;
} else {
  console.error('[wod] Running directly from Git checkout requires Bun (https://bun.sh).');
  console.error('      Install Bun or run `bun run build:packages` first.');
  process.exit(1);
}
